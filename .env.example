# Application
APP_NAME=ECICA
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL (Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecica_db
DB_USER=postgres
DB_PASSWORD=secret
DB_SSL=false

# Authentification JWT
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Administrateur initial (utilisé par scripts/init-admin.js)
ADMIN_EMAIL=admin@ecica.edu.ml
ADMIN_PASSWORD=change_this_password

