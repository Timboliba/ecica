extends ./layout.pug

block content
  .error-page-container(style="min-height: 55vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 40px 20px;")
    .error-card(style="max-width: 520px; background: #fff; border-radius: 16px; border: 1px solid #e2e8f0; padding: 48px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.05);")
      span(style="display: inline-block; font-size: 4.5rem; font-weight: 800; color: #dc2626; line-height: 1; margin-bottom: 12px;") 500
      h1(style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0 0 10px;") Une erreur est survenue
      p(style="font-size: 0.95rem; color: #64748b; margin: 0 0 28px; line-height: 1.5;") Notre équipe technique a été informée et travaille à résoudre le problème. Veuillez réessayer dans quelques instants.
      if error && error.message
        pre(style="text-align: left; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px; border-radius: 8px; font-size: 0.8rem; overflow-x: auto; margin-bottom: 24px;")= error.stack || error.message
      .error-actions(style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;")
        a(href="/" style="display: inline-flex; align-items: center; gap: 8px; background: #2563eb; color: #fff; font-weight: 600; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-size: 0.9rem;")
          svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
            path(d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z")
          span Retour à l'accueil
        button(type="button" onclick="window.location.reload()" style="display: inline-flex; align-items: center; gap: 8px; background: #f8fafc; color: #475569; border: 1px solid #cbd5e1; font-weight: 600; padding: 12px 24px; border-radius: 8px; font-size: 0.9rem; cursor: pointer;")
          span Réessayer

