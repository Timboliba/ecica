extends ./layout.pug

block styles
  link(rel="stylesheet", href="/css/detailsFormation.css?v=1.2")

block content
  .details-formation-page
    //- Fil d'Ariane
    nav.df-breadcrumb(aria-label="Fil d'Ariane")
      a(href="/") Accueil
      span.separator &rsaquo;
      a(href="/#formations") Formations
      span.separator &rsaquo;
      span.current= formation ? formation.title : "Détails de la formation"

    //- Hero Banner de la formation
    header.df-hero
      span.df-hero__badge= formation ? formation.badge : "Formation Professionnelle"
      h1.df-hero__title= formation ? formation.title : "Formation E.C.I.C.A"

      .df-hero__meta-grid
        .df-hero__meta-item
          svg.df-hero__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
            line(x1="16", y1="2", x2="16", y2="6")
            line(x1="8", y1="2", x2="8", y2="6")
            line(x1="3", y1="10", x2="21", y2="10")
          .df-hero__meta-info
            span.df-hero__meta-label Rentrée prévue
            span.df-hero__meta-value= formation ? formation.date : "Prochaine session"

        .df-hero__meta-item
          svg.df-hero__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            circle(cx="12", cy="12", r="10")
            polyline(points="12 6 12 12 16 14")
          .df-hero__meta-info
            span.df-hero__meta-label Durée
            span.df-hero__meta-value= formation ? formation.duree : "9 mois"

        .df-hero__meta-item
          svg.df-hero__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
            circle(cx="12", cy="7", r="4")
          .df-hero__meta-info
            span.df-hero__meta-label Organisateur
            span.df-hero__meta-value= formation ? formation.organisateur : "E.C.I.C.A"

        .df-hero__meta-item
          svg.df-hero__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            path(d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z")
            circle(cx="12", cy="10", r="3")
          .df-hero__meta-info
            span.df-hero__meta-label Lieu
            span.df-hero__meta-value= formation ? formation.lieu : "Campus Bamako Médina-Coura"

    //- Contenu principal en 2 colonnes
    .df-layout
      //- Colonne Gauche : Détails du cursus
      main.df-main
        //- Section 1 : Présentation
        section.df-section
          h2.df-section__title
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              circle(cx="12", cy="12", r="10")
              line(x1="12", y1="16", x2="12", y2="12")
              line(x1="12", y1="8", x2="12.01", y2="8")
            span Présentation de la formation
          p.df-text= formation ? formation.description : "Programme de formation professionnelle délivré par l'E.C.I.C.A."

        //- Section 2 : Objectifs pédagogiques
        if formation && formation.objectifs && formation.objectifs.length
          section.df-section
            h2.df-section__title
              svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                polygon(points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2")
              span Objectifs & compétences visées
            ul.df-objectives-list
              each obj in formation.objectifs
                li.df-objective-item
                  svg.df-check-icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="3", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                    polyline(points="20 6 9 17 4 12")
                  span= obj

        //- Section 3 : Programme & Modules
        if formation && formation.programme && formation.programme.length
          section.df-section
            h2.df-section__title
              svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                path(d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20")
                path(d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z")
              span Programme des modules d'enseignement
            .df-modules-list
              each item in formation.programme
                article.df-module-card
                  h3.df-module-title= item.module
                  p.df-module-desc= item.details

        //- Section 4 : Débouchés professionnels
        if formation && formation.debouches && formation.debouches.length
          section.df-section
            h2.df-section__title
              svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                rect(x="2", y="7", width="20", height="14", rx="2", ry="2")
                path(d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16")
              span Métiers & opportunités professionnelles
            .df-tags-grid
              each metier in formation.debouches
                span.df-tag
                  svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                    polyline(points="9 18 15 12 9 6")
                  span= metier

        //- Section 5 : Prérequis & Conditions
        section.df-section
          h2.df-section__title
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
              polyline(points="14 2 14 8 20 8")
              line(x1="16", y1="13", x2="8", y2="13")
              line(x1="16", y1="17", x2="8", y2="17")
            span Conditions d'admission & Diplôme délivré
          .df-prereq-box
            .df-prereq-item
              svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                circle(cx="12", cy="12", r="10")
                line(x1="12", y1="8", x2="12", y2="12")
                line(x1="12", y1="16", x2="12.01", y2="16")
              div
                strong Prérequis / Public cible : 
                span= formation ? formation.prerequis : "Baccalauréat ou expérience équivalente."
            .df-prereq-item
              svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                path(d="M22 11.08V12a10 10 0 1 1-5.93-9.14")
                polyline(points="22 4 12 14.01 9 11.01")
              div
                strong Certification délivrée : 
                span= formation ? formation.certification : "Certificat de Qualification Professionnelle E.C.I.C.A."

      //- Colonne Droite : Fiche récapitulative & Action d'inscription
      aside.df-sidebar
        .df-summary-card
          .df-summary-image
            img(src=formation && formation.image ? formation.image : "/img/picture4.webp", alt=formation ? formation.title : "Formation", loading="lazy")
          .df-summary-body
            .df-summary-facts
              .df-fact-row
                span.df-fact-label Rentrée :
                span.df-fact-value= formation ? formation.date : "05 Février 2027"
              .df-fact-row
                span.df-fact-label Durée :
                span.df-fact-value= formation ? formation.duree : "9 mois"
              .df-fact-row
                span.df-fact-label Rythme :
                span.df-fact-value= formation ? formation.rythme : "Jour & Soir"
              .df-fact-row
                span.df-fact-label Niveau :
                span.df-fact-value= formation ? formation.niveau : "Bac / CAP / Équivalent"
              .df-fact-row
                span.df-fact-label Places :
                span.df-fact-value= formation ? formation.places : "Limitées"

            a.df-cta-button.df-cta-button--primary(href="/contact?subject=" + encodeURIComponent("Inscription : " + (formation ? formation.title : "Formation")))
              svg(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                path(d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                circle(cx="12", cy="7", r="4")
                line(x1="20", y1="8", x2="20", y2="14")
                line(x1="23", y1="11", x2="17", y2="11")
              span Postuler / S'inscrire

            button.df-cta-button.df-cta-button--secondary(type="button", onclick="window.print()")
              svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                polyline(points="6 9 6 2 18 2 18 9")
                path(d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2")
                rect(x="6", y="14", width="12", height="8")
              span Imprimer la fiche

        //- Assistance et Contact
        .df-contact-help
          h4.df-contact-help__title Besoin d'un conseil ?
          p.df-contact-help__text L'équipe pédagogique et le secrétariat de l'E.C.I.C.A sont à votre disposition pour vous orienter.
          a.df-contact-link(href="tel:+22320222691")
            span 📞
            span +223 20 22 26 91
          a.df-contact-link(href="mailto:contact@ecica.ml")
            span ✉️
            span contact@ecica.ml
          a.df-contact-link(href="/contact")
            span 📍
            span Nous rendre visite au campus

    //- Section Autres formations
    if otherFormations && otherFormations.length
      section.df-related
        .df-related__header
          .section-heading
            span Formations complémentaires
            h2.df-related__title Autres formations à découvrir
          a.df-related__all-link(href="/#formations")
            span Voir toutes les formations
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              line(x1="5", y1="12", x2="19", y2="12")
              polyline(points="12 5 19 12 12 19")
        .df-related__grid
          each rel in otherFormations
            article.formation-card(data-url="/Formation/detailsFormation?id=" + rel.id)
              .formation-card__images
                img(src=rel.image, alt=rel.title, loading="lazy")
                span.formation-card__badge= rel.badge
              .formation-card__body
                h3.formation-card__title= rel.title
                .formation-card__meta
                  .formation-card__meta-item
                    svg.formation-card__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                      rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
                      line(x1="16", y1="2", x2="16", y2="6")
                      line(x1="8", y1="2", x2="8", y2="6")
                      line(x1="3", y1="10", x2="21", y2="10")
                    .formation-card__meta-text
                      span.formation-card__meta-label Date de formation
                      span.formation-card__meta-value= rel.date
                  .formation-card__meta-item
                    svg.formation-card__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                      path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                      circle(cx="12", cy="7", r="4")
                    .formation-card__meta-text
                      span.formation-card__meta-label Organisateur
                      span.formation-card__meta-value= rel.organisateur
                a.formation-card__cta(href="/Formation/detailsFormation?id=" + rel.id)
                  span Découvrir la formation
                  svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                    line(x1="5", y1="12", x2="19", y2="12")
                    polyline(points="12 5 19 12 12 19")
