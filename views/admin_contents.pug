    //- ── MODALE D'AJOUT D'UN CONTENU ───────────────────────────────────────
    #modal-create-content.admin-modal-backdrop(style="display: none;")
      .admin-modal-dialog.content-modal-dialog
        .admin-modal-header
          h3.admin-modal-title Ajouter un nouveau contenu
          button.admin-modal-close(type="button", aria-label="Fermer") &times;
        form#form-create-content(method="POST", action="/admin/contents", enctype="multipart/form-data")
          .admin-modal-body
            .modal-alert(style="display: none;")
            .form-grid
              .form-field
                label(for="content-title") Titre *
                input#content-title(type="text", name="title", maxlength="200", placeholder="Ex: Ouverture des inscriptions 2026", required)
              .form-row-2
                .form-field
                  label(for="content-category") Catégorie *
                  select#content-category(name="category", required)
                    option(value="actualite", selected) Actualité
                    option(value="formation") Formation
                    option(value="evenement") Événement
                    option(value="annonce") Annonce
                .form-field
                  label(for="content-status") Statut
                  select#content-status(name="status")
                    option(value="published", selected) Publié
                    option(value="draft") Brouillon
              .form-field
                label(for="content-published-at") Date de publication
                input#content-published-at(type="datetime-local", name="published_at")
              .form-field
                label(for="content-summary") Résumé
                input#content-summary(type="text", name="summary", maxlength="255", placeholder="Courte description affichée dans la liste")
              .form-field
                label(for="content-body") Contenu
                textarea#content-body(name="body", rows="6", placeholder="Rédigez le contenu de la publication...")
              .form-field
                label(for="content-image") Image de couverture
                input#content-image(type="file", name="image", accept=".png,.jpg,.jpeg,.webp,.gif,image/png,image/jpeg,image/webp,image/gif")
                span.form-hint Formats : PNG, JPG, WEBP, GIF — 5 Mo max.
                img#content-image-preview.content-image-preview(alt="Aperçu de l'image", style="display: none;")
          .admin-modal-footer
            button.btn-modal-cancel(type="button") Annuler
            button.btn-modal-submit(type="submit")
              span.btn-text Enregistrer le contenu
              span.btn-spinner(style="display: none;") ⏳ Enregistrement...

block scripts
  script.
    function filterContents(cat, btn) {
      document.querySelectorAll('.cft-tab').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      document.querySelectorAll('.contents-row').forEach(function(row) {
        row.style.display = (cat === 'tous' || row.getAttribute('data-category') === cat) ? '' : 'none';
      });
      updatePagInfo();
    }
    function searchContents(query) {
      var term = (query || '').toLowerCase().trim();
      document.querySelectorAll('.contents-row').forEach(function(row) {
        var t = (row.querySelector('.contents-item-title')||{}).textContent||'';
        var s = (row.querySelector('.contents-item-sub')||{}).textContent||'';
        var c = (row.querySelector('.contents-cat-badge')||{}).textContent||'';
        row.style.display = (!term || t.toLowerCase().includes(term) || s.toLowerCase().includes(term) || c.toLowerCase().includes(term)) ? '' : 'none';
      });
      updatePagInfo();
    }
    function toggleAllContents(master) {
      document.querySelectorAll('#contents-tbody .ck-checkbox').forEach(function(c) { c.checked = master.checked; });
    }
    function updatePagInfo() {
