extends layout

block content
  .home-container
    section.home-hero
      .home-hero__media
        img(src="/img/picture4.webp", alt="Étudiants de l'E.C.I.C.A")
      .home-hero__content
        span.home-kicker École Centrale pour l'Industrie, le Commerce et l'Administration
        h1 E.C.I.C.A
        p Une formation professionnelle exigeante, tournée vers l'industrie, le commerce et l'administration.
        .home-hero__actions
          a.home-button(href="/presentation/Presentation") Découvrir l'école
          a.home-button.home-button--secondary(href="/contact") Nous contacter

    section.acces-direct-container
      .section-heading
        span Accès rapide
        h2 Informations utiles
      .acces-cards
        article.acces-item
          a.link-menu(href="/Emplois")
            img(src="/img/Emploi_du_temps.webp", alt="Emploi du temps", loading="lazy")
            .acces-item__body
              b Emplois du temps
              p.details
                span 18 mars 2026
                span Étudiants
    section.formation-ecica#formations
      .formation-header
        .section-heading
          span Formations
          h2 Nos formations à venir
        .formation-pagination
          button.formation-nav-btn.formation-nav-btn--prev(type="button", aria-label="Page précédente", disabled)
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              polyline(points="15 18 9 12 15 6")
          span.formation-page-indicator 1 / 2
          button.formation-nav-btn.formation-nav-btn--next(type="button", aria-label="Page suivante")
            svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              polyline(points="9 18 15 12 9 6")

      .formation-slider-wrapper
        .formation-cards
          if formations && formations.length
            each f in formations
              article.formation-card(data-url="/Formation/detailsFormation?id=" + f.id)
                .formation-card__images
                  img(src=f.image || "/img/picture1.webp", alt=f.title, loading="lazy")
                  span.formation-card__badge= f.badge || "Formation"
                .formation-card__body
                  h3.formation-card__title= f.title
                  .formation-card__meta
                    .formation-card__meta-item
                      svg.formation-card__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                        rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
                        line(x1="16", y1="2", x2="16", y2="6")
                        line(x1="8", y1="2", x2="8", y2="6")
                        line(x1="3", y1="10", x2="21", y2="10")
                      .formation-card__meta-text
                        span.formation-card__meta-label Date de formation
                        span.formation-card__meta-value= f.date || "Prochainement"
                    .formation-card__meta-item
                      svg.formation-card__icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                        path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                        circle(cx="12", cy="7", r="4")
                      .formation-card__meta-text
                        span.formation-card__meta-label Organisateur
                        span.formation-card__meta-value= f.organisateur || "E.C.I.C.A"
                  a.formation-card__cta(href="/Formation/detailsFormation?id=" + f.id)
                    span Découvrir la formation
                    svg(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                      line(x1="5", y1="12", x2="19", y2="12")
                      polyline(points="12 5 19 12 12 19")
          else
            p(style="padding: 2rem; color: #64748b; font-style: italic;") Aucune formation disponible pour le moment.
    section.a-l-a-une-container
      .posts
        .carousel-imgs_acces-directs
          .carousel-imgs
            .section-heading
              span Actualités
              h2 À la une
            .carousel
              article
                img.article_imgs(src="/img/picture4.webp", alt="Actualité E.C.I.C.A")
              .carousel-controle
                .prev
                .next

        .about-school-section
          .section-heading
            span À propos
            h2 Une école au service des talents
          .about-school-description
            p L'École Centrale pour l'Industrie, le Commerce et l'Administration (E.C.I.C.A) est une institution de référence historique, pionnière dans la formation professionnelle d'excellence. Depuis sa création, elle forme des cadres, des techniciens et des entrepreneurs qui contribuent activement au développement socio-économique de la nation.
            p Animée par des valeurs de rigueur, d'intégrité et d'innovation, l'école propose une approche pédagogique pluridisciplinaire de haut niveau, couvrant les filières industrielles ainsi que les domaines stratégiques du commerce et de l'administration.
            p Grâce à un corps professoral engagé, des infrastructures en modernisation continue et un réseau de partenaires institutionnels et professionnels, l'E.C.I.C.A prépare ses étudiants à relever les défis du marché de l'emploi avec assurance et leadership.

        .guide-actualiser
          .guide-actualiser-header
            .section-heading
              span(style="color:#000") Ressource
              h2 Guide de l'étudiant
            p.title Retrouvez les informations essentielles pour réussir votre parcours à l'E.C.I.C.A.
          a.guide-actualiser-img(href="#")
            img(src="/img/IMG_0288.webp", alt="Guide de l'étudiant", loading="lazy")

        .static-container
          .chiffer-container
            h3 E.C.I.C.A en chiffres
            .chiffre-datas
              .chiffre-item
                .data
                  span 259
                .title Professeurs
              .chiffre-item
                .data
                  span 4751
                .title Étudiants
              .chiffre-item
                .data
                  span 258
                .title Étudiants internationaux
              .chiffre-item
                .data
                  span 3000
                .title Diplômés
          .mission-container
            h3 Notre mission
            .mission-description
              p L'E.C.I.C.A promeut une formation professionnelle d'excellence en dotant ses élèves de compétences adaptées au monde professionnel et aux exigences du marché du travail.
            .date-container
              h4 Création
              span 1969
