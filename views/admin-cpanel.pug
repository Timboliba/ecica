doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= pageTitle || "Dashboard Admin"
    link(rel="shortcut icon", href="/img/logo_ecica.webp", type="image/x-icon")
    link(rel="stylesheet", href="/css/admin-cpanel.css?v=2.4")
    link(rel="stylesheet", href="/css/skeleton.css?v=1.0")
  body
    .admin-layout
      //- SIDEBAR
      aside.admin-sidebar
        .sidebar-header
          .brand-logo-icon
            img(class="logo" src="/img/logo_ecica.webp" alt="ECICA" style="width: 40px; height: 40px;")

          .brand-text
            .brand-title ECI<span>CA</span>

          button#btn-close-sidebar-mobile.btn-close-sidebar-mobile(type="button", aria-label="Fermer le menu")
            svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
              line(x1="18", y1="6", x2="6", y2="18")
              line(x1="6", y1="6", x2="18", y2="18")

        nav.sidebar-nav
          a.nav-item(href="/admin/cpanel", class=(activeMenu === "dashboard" || !activeMenu ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                rect(x="3", y="3", width="7", height="7", rx="1")
                rect(x="14", y="3", width="7", height="7", rx="1")
                rect(x="14", y="14", width="7", height="7", rx="1")
                rect(x="3", y="14", width="7", height="7", rx="1")
            span.nav-label Dashboard

          a.nav-item(href="/admin/emplois", class=(activeMenu === "emplois" ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2")
                circle(cx="9", cy="7", r="4")
                path(d="M23 21v-2a4 4 0 0 0-3-3.87")
                path(d="M16 3.13a4 4 0 0 1 0 7.75")
            span.nav-label Gestion Emploi du temps

          a.nav-item(href="/admin/formations", class=((activeMenu === "formations" || activeMenu === "projects") ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z")
            span.nav-label Formations

          a.nav-item(href="/admin/requests", class=((activeMenu === "requests" || activeMenu === "reglements") ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20")
                path(d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z")
            span.nav-label Lois & Règlements

          a.nav-item(href="/admin/contents", class=(activeMenu === "contents" ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                polyline(points="14 2 14 8 20 8")
                line(x1="16", y1="13", x2="8", y2="13")
                line(x1="16", y1="17", x2="8", y2="17")
                polyline(points="10 9 9 9 8 9")
            span.nav-label Contenus

          a.nav-item(href="/admin/users", class=(activeMenu === "users" ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                circle(cx="12", cy="7", r="4")
            span.nav-label Utilisateurs

          a.nav-item(href="/admin/analytics", class=(activeMenu === "analytics" ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                line(x1="18", y1="20", x2="18", y2="10")
                line(x1="12", y1="20", x2="12", y2="4")
                line(x1="6", y1="20", x2="6", y2="14")
            span.nav-label Analytics

          a.nav-item(href="/admin/settings", class=(activeMenu === "settings" ? "active" : ""))
            span.nav-icon
              svg(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="12", cy="12", r="3")
                path(d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z")
            span.nav-label Paramètres

        .sidebar-footer
          .user-profile-widget(title="Profil Administrateur")
            .user-avatar-wrap
              img.user-avatar-img(src="/img/avatar.webp", alt=(user && user.name) ? user.name : "Admin")
            .user-info-text
              span.user-name= (user && user.name) ? user.name : ((user && user.login) ? user.login : "Administrateur")
              span.user-role= (user && user.role) ? user.role : "Administrateur"
            a.user-logout-btn(href="/admin/logout", title="Se déconnecter", style="margin-left: auto; color: #ef4444; display: inline-flex; align-items: center; justify-content: center; padding: 6px; text-decoration: none; border-radius: 4px;")
              svg(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                polyline(points="16 17 21 12 16 7")
                line(x1="21", y1="12", x2="9", y2="12")

          button#btn-collapse-sidebar.btn-collapse-sidebar(type="button", title="Réduire le menu")
            svg(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
              polyline(points="15 18 9 12 15 6")
            span Réduire le menu

      //- BACKDROP OVERLAY MOBILE/TABLETTE
      #admin-sidebar-backdrop.admin-sidebar-backdrop(aria-hidden="true")

      //- MAIN AREA
      main.admin-main
        //- TOP NAVBAR
        header.admin-topbar
          .topbar-left
            button#btn-toggle-menu.btn-toggle-menu(type="button", aria-label="Menu")
              svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                line(x1="3", y1="12", x2="21", y2="12")
                line(x1="3", y1="6", x2="21", y2="6")
                line(x1="3", y1="18", x2="21", y2="18")
            -
              const navTitles = {
                'dashboard': 'Dashboard',
                'crm': 'Emploi du temps',
                'formations': 'Formations',
                'projects': 'Formations',
                'requests': 'Lois & Règlements',
                'reglements': 'Lois & Règlements',
                'contents': 'Contenus',
                'users': 'Gestion des Utilisateurs',
                'analytics': 'Analytics',
                'settings': 'Paramètres'
              };
              const activePageTitle = headerTitle || (activeMenu && navTitles[activeMenu]) || (pageTitle ? pageTitle.split(' - ')[0] : 'Dashboard');
            h1.page-title= activePageTitle

          .topbar-center
            .search-box-wrap
              svg.search-icon(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="11", cy="11", r="8")
                line(x1="21", y1="21", x2="16.65", y2="16.65")
              input#admin-search-input.search-input(type="text", placeholder="Rechercher (prospects, entreprises, projets...)")
              span.kbd-shortcut ⌘ K

          .topbar-right
            button.topbar-action-btn(type="button", title="Notifications")
              svg(width="19", height="19", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                path(d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9")
                path(d="M13.73 21a2 2 0 0 1-3.46 0")
              span.notification-badge 5

            button.topbar-action-btn(type="button", title="Aide & Documentation")
              svg(width="19", height="19", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                circle(cx="12", cy="12", r="10")
                path(d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3")
                line(x1="12", y1="17", x2="12.01", y2="17")

            button.tenant-selector-btn(type="button")
              span AVERIC SAS
              svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                polyline(points="6 9 12 15 18 9")

        //- DYNAMIC SPA CONTENT CONTAINER
        #admin-spa-content.spa-content-area
          block content

    script(src="/javascript/admin-cpanel.js?v=2.4")
    block scripts
