            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Durée
              input#edit-formation-duree(type="text" name="duree" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")
            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Rythme
              input#edit-formation-rythme(type="text" name="rythme" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")
            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Niveau requis
              input#edit-formation-niveau(type="text" name="niveau" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")

          .form-grid-4(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px;")
            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Lieu
              input#edit-formation-lieu(type="text" name="lieu" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")
            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Organisateur
              input#edit-formation-organisateur(type="text" name="organisateur" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")
            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Places
              input#edit-formation-places(type="text" name="places" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")
            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Frais
              input#edit-formation-frais(type="text" name="frais" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")

        //- BLOC 3 : OBJECTIFS & MODULES
        .form-section-card(style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px;")
          h4(style="margin: 0 0 14px; font-size: 0.95rem; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 8px;")
            span(style="width: 24px; height: 24px; border-radius: 6px; background: #7c3aed; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem;") 3
            span Objectifs pédagogiques & Modules du programme

          .form-group(style="margin-bottom: 18px;")
            label(style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 8px;")
              span Objectifs visés
              button#btn-edit-add-objective-row.btn-text-action(type="button" style="color: #2563eb; background: none; border: none; font-size: 0.825rem; font-weight: 600; cursor: pointer;") + Ajouter un objectif
            #edit-objectives-list(style="display: flex; flex-direction: column; gap: 8px;")

          .form-group
            label(style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 8px;")
              span Programme des modules
              button#btn-edit-add-module-row.btn-text-action(type="button" style="color: #2563eb; background: none; border: none; font-size: 0.825rem; font-weight: 600; cursor: pointer;") + Ajouter un module
            #edit-modules-list(style="display: flex; flex-direction: column; gap: 12px;")

        //- BLOC 4 : ADMISSION & DÉBOUCHÉS
        .form-section-card(style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px;")
          h4(style="margin: 0 0 14px; font-size: 0.95rem; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 8px;")
            span(style="width: 24px; height: 24px; border-radius: 6px; background: #f97316; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem;") 4
            span Admission, Diplôme & Métiers

          .form-group(style="margin-bottom: 14px;")
            label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Prérequis / Public admissible
            textarea#edit-formation-prerequis(name="prerequis" rows="2" style="width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; font-family: inherit; box-sizing: border-box;")

          .form-grid-2(style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;")
            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Diplôme / Certification
              input#edit-formation-certification(type="text" name="certification" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")

            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Débouchés (séparés par des virgules)
              input#edit-formation-debouches(type="text" name="debouches" style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")

        .modal-form-actions(style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; position: sticky; bottom: 0; background: #fff; padding-top: 14px; border-top: 1px solid #e2e8f0;")
          button#admin-btn-cancel-edit-formation(type="button" style="background: #fff; color: #475569; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px 18px; font-size: 0.875rem; font-weight: 600; cursor: pointer;") Annuler
          button#admin-btn-submit-edit-formation(type="submit" style="background: #2563eb; color: #fff; border: none; border-radius: 8px; padding: 10px 22px; font-size: 0.875rem; font-weight: 600; cursor: pointer;") Mettre à jour la formation

  script.
    window.initAdminFormations = function () {
      const searchInput = document.getElementById("admin-formation-search");
      const btnClearSearch = document.getElementById("admin-btn-clear-formation-search");
      const filterTabs = document.querySelectorAll(".formation-filter-tab");
      const rows = document.querySelectorAll(".admin-formation-row");

      let currentCategory = "all";

      function filterRows() {
        const query = (searchInput ? searchInput.value : "").trim().toLowerCase();
        if (btnClearSearch) btnClearSearch.style.display = query ? "block" : "none";

        rows.forEach(r => {
          const name = r.getAttribute("data-name") || "";
          const badge = r.getAttribute("data-badge") || "";
          const desc = r.getAttribute("data-desc") || "";

          const matchesQuery = !query || name.includes(query) || badge.includes(query) || desc.includes(query);
          const matchesCategory = currentCategory === "all" || badge.toLowerCase().includes(currentCategory.toLowerCase());

          r.style.display = (matchesQuery && matchesCategory) ? "" : "none";
        });
      }

      if (searchInput) searchInput.addEventListener("input", filterRows);
      if (btnClearSearch) {
        btnClearSearch.addEventListener("click", () => {
          searchInput.value = "";
          filterRows();
          searchInput.focus();
        });
      }

      filterTabs.forEach(tab => {
        tab.addEventListener("click", () => {
          filterTabs.forEach(t => t.classList.remove("active"));
          tab.classList.add("active");
          currentCategory = tab.getAttribute("data-filter") || "all";
          filterRows();
        });
      });

      // Modales
      const modalAdd = document.getElementById("admin-modal-add-formation");
      const btnOpenAdd = document.getElementById("btn-admin-add-formation");
      const btnCloseAdd = document.getElementById("admin-modal-add-formation-close");
      const btnCancelAdd = document.getElementById("admin-btn-cancel-add-formation");
      const formAdd = document.getElementById("admin-form-add-formation");

      const modalEdit = document.getElementById("admin-modal-edit-formation");
      const btnCloseEdit = document.getElementById("admin-modal-edit-formation-close");
      const btnCancelEdit = document.getElementById("admin-btn-cancel-edit-formation");
      const formEdit = document.getElementById("admin-form-edit-formation");

      function openModal(modal) {
        if (!modal) return;
        modal.style.display = "flex";
        document.body.style.overflow = "hidden";
      }

      function closeModal(modal, form = null) {
        if (!modal) return;
        modal.style.display = "none";
        document.body.style.overflow = "";
        if (form) form.reset();
      }

      if (btnOpenAdd) {
        btnOpenAdd.addEventListener("click", () => {
          openModal(modalAdd);
          const titleInput = document.getElementById("add-formation-title");
          if (titleInput) titleInput.focus();
        });
      }

      if (btnCloseAdd) btnCloseAdd.addEventListener("click", () => closeModal(modalAdd, formAdd));
      if (btnCancelAdd) btnCancelAdd.addEventListener("click", () => closeModal(modalAdd, formAdd));
      if (modalAdd) {
        const ov = modalAdd.querySelector(".modal-overlay");
        if (ov) ov.addEventListener("click", () => closeModal(modalAdd, formAdd));
      }

      if (btnCloseEdit) btnCloseEdit.addEventListener("click", () => closeModal(modalEdit, formEdit));
      if (btnCancelEdit) btnCancelEdit.addEventListener("click", () => closeModal(modalEdit, formEdit));
      if (modalEdit) {
        const ov = modalEdit.querySelector(".modal-overlay");
        if (ov) ov.addEventListener("click", () => closeModal(modalEdit, formEdit));
      }

      // Ajout dynamique d'objectifs dans le formulaire d'ajout
      const btnAddObjRow = document.getElementById("btn-add-objective-row");
      const objContainer = document.getElementById("add-objectives-list");
      if (btnAddObjRow && objContainer) {
        btnAddObjRow.addEventListener("click", () => {
          const row = document.createElement("div");
          row.className = "dynamic-input-row";
          row.style.cssText = "display: flex; gap: 8px; align-items: center;";
          row.innerHTML = `
            <input type="text" name="objectifs[]" placeholder="Objectif ou compétence..." style="flex: 1; height: 38px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.875rem; box-sizing: border-box;" />
            <button type="button" class="btn-remove-row" style="width: 32px; height: 32px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">&times;</button>
          `;
          objContainer.appendChild(row);
          row.querySelector("input").focus();
        });
      }

      // Ajout dynamique de modules dans le formulaire d'ajout
      const btnAddModRow = document.getElementById("btn-add-module-row");
      const modContainer = document.getElementById("add-modules-list");
      if (btnAddModRow && modContainer) {
        btnAddModRow.addEventListener("click", () => {
          const card = document.createElement("div");
          card.className = "dynamic-module-card";
          card.style.cssText = "background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px; position: relative;";
          card.innerHTML = `
            <div style="display: flex; gap: 8px; align-items: center;">
              <input type="text" name="module_titles[]" placeholder="Titre du module (ex: Module 2 : Automatisme)" style="flex: 1; height: 36px; padding: 0 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem; font-weight: 600; box-sizing: border-box;" />
              <button type="button" class="btn-remove-row" style="width: 30px; height: 30px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">&times;</button>
            </div>
            <textarea name="module_details[]" rows="2" placeholder="Détails du module et matières..." style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.825rem; font-family: inherit; box-sizing: border-box;"></textarea>
          `;
          modContainer.appendChild(card);
          card.querySelector("input").focus();
        });
      }

      // Délégation de suppression d'une ligne dynamique
      document.addEventListener("click", (e) => {
        const removeBtn = e.target.closest(".btn-remove-row");
        if (removeBtn) {
          const row = removeBtn.closest(".dynamic-input-row, .dynamic-module-card");
          if (row) row.remove();
        }
      });

      // Soumission formulaire d'ajout (avec protection anti-double soumission)
      if (formAdd && !formAdd.dataset.hasSubmitListener) {
        formAdd.dataset.hasSubmitListener = "true";
        let isSubmittingAdd = false;

        formAdd.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (isSubmittingAdd) return;
          isSubmittingAdd = true;

          const submitBtn = document.getElementById("admin-btn-submit-add-formation");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Publication en cours...";
          }

          try {
            const formData = new FormData(formAdd);
            const res = await fetch("/admin/formations/add", {
              method: "POST",
              body: formData,
              headers: { "Accept": "application/json" }
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
              throw new Error(data.error || "Erreur lors de la création.");
            }

            closeModal(modalAdd, formAdd);
            // Recharger la vue via SPA
            if (typeof window.navigateTo === "function") {
              await window.navigateTo("/admin/formations", false);
            } else {
              window.location.reload();
            }
          } catch (err) {
            alert(err.message || "Erreur lors de la création de la formation.");
          } finally {
            isSubmittingAdd = false;
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Enregistrer & Publier";
            }
          }
        });
      }

      // Actions sur les lignes (Modifier & Supprimer)
      document.addEventListener("click", async (e) => {
        const editBtn = e.target.closest(".btn-edit-formation");
        if (editBtn) {
          const id = editBtn.getAttribute("data-id");
          try {
            const res = await fetch(`/admin/formations/api/${id}`);
            const data = await res.json();
            if (!data.success || !data.item) throw new Error("Formation introuvable");

            const item = data.item;
            document.getElementById("edit-formation-id").value = item.id;
            document.getElementById("edit-formation-title").value = item.title || "";
            document.getElementById("edit-formation-badge").value = item.badge || "";
            document.getElementById("edit-formation-desc").value = item.description || "";
            document.getElementById("edit-formation-date").value = item.date || "";
            document.getElementById("edit-formation-duree").value = item.duree || "";
            document.getElementById("edit-formation-rythme").value = item.rythme || "";
            document.getElementById("edit-formation-niveau").value = item.niveau || "";
            document.getElementById("edit-formation-lieu").value = item.lieu || "";
            document.getElementById("edit-formation-organisateur").value = item.organisateur || "";
            document.getElementById("edit-formation-places").value = item.places || "";
            document.getElementById("edit-formation-frais").value = item.frais || "";
            document.getElementById("edit-formation-prerequis").value = item.prerequis || "";
            document.getElementById("edit-formation-certification").value = item.certification || "";
            document.getElementById("edit-formation-debouches").value = (item.debouches || []).join(", ");

            // Remplir les objectifs dans la modale d'édition
            const editObjContainer = document.getElementById("edit-objectives-list");
            editObjContainer.innerHTML = "";
            const objectifs = (item.objectifs && item.objectifs.length) ? item.objectifs : [""];
            objectifs.forEach(obj => {
              const row = document.createElement("div");
              row.className = "dynamic-input-row";
              row.style.cssText = "display: flex; gap: 8px; align-items: center;";
              row.innerHTML = `
                <input type="text" name="objectifs[]" value="${obj.replace(/"/g, '&quot;')}" placeholder="Objectif ou compétence..." style="flex: 1; height: 38px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.875rem; box-sizing: border-box;" />
                <button type="button" class="btn-remove-row" style="width: 32px; height: 32px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">&times;</button>
              `;
              editObjContainer.appendChild(row);
            });

            // Remplir les modules dans la modale d'édition
            const editModContainer = document.getElementById("edit-modules-list");
            editModContainer.innerHTML = "";
            const modules = (item.programme && item.programme.length) ? item.programme : [{ module: "", details: "" }];
            modules.forEach(m => {
              const card = document.createElement("div");
              card.className = "dynamic-module-card";
              card.style.cssText = "background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px; position: relative;";
              card.innerHTML = `
                <div style="display: flex; gap: 8px; align-items: center;">
                  <input type="text" name="module_titles[]" value="${(m.module || '').replace(/"/g, '&quot;')}" placeholder="Titre du module" style="flex: 1; height: 36px; padding: 0 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem; font-weight: 600; box-sizing: border-box;" />
                  <button type="button" class="btn-remove-row" style="width: 30px; height: 30px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">&times;</button>
                </div>
                <textarea name="module_details[]" rows="2" placeholder="Détails du module..." style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.825rem; font-family: inherit; box-sizing: border-box;">${m.details || ''}</textarea>
              `;
              editModContainer.appendChild(card);
            });

            openModal(modalEdit);
          } catch (err) {
            alert(err.message || "Erreur lors du chargement de la formation.");
          }
        }

        const delBtn = e.target.closest(".btn-delete-formation");
        if (delBtn) {
          const id = delBtn.getAttribute("data-id");
          const name = delBtn.getAttribute("data-name");
          if (confirm(`Voulez-vous vraiment supprimer définitivement la formation "${name}" ?`)) {
            try {
              const res = await fetch(`/admin/formations/delete/${id}`, {
                method: "POST",
                headers: { "Accept": "application/json" }
              });
              const data = await res.json();
              if (!res.ok || !data.success) throw new Error(data.error || "Erreur");

              const row = delBtn.closest(".admin-formation-row");
              if (row) row.remove();
              const kpiTotal = document.getElementById("kpi-total-formations");
              if (kpiTotal) kpiTotal.textContent = document.querySelectorAll(".admin-formation-row").length;
            } catch (err) {
              alert(err.message || "Erreur lors de la suppression.");
            }
          }
        }
      });

      // Ajout dynamique dans formulaire d'édition
      const btnEditAddObj = document.getElementById("btn-edit-add-objective-row");
      const editObjContainer = document.getElementById("edit-objectives-list");
      if (btnEditAddObj && editObjContainer) {
        btnEditAddObj.addEventListener("click", () => {
          const row = document.createElement("div");
          row.className = "dynamic-input-row";
          row.style.cssText = "display: flex; gap: 8px; align-items: center;";
          row.innerHTML = `
            <input type="text" name="objectifs[]" placeholder="Nouvel objectif..." style="flex: 1; height: 38px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.875rem; box-sizing: border-box;" />
            <button type="button" class="btn-remove-row" style="width: 32px; height: 32px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">&times;</button>
          `;
          editObjContainer.appendChild(row);
          row.querySelector("input").focus();
        });
      }

      const btnEditAddMod = document.getElementById("btn-edit-add-module-row");
      const editModContainer = document.getElementById("edit-modules-list");
      if (btnEditAddMod && editModContainer) {
        btnEditAddMod.addEventListener("click", () => {
          const card = document.createElement("div");
          card.className = "dynamic-module-card";
          card.style.cssText = "background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px; position: relative;";
          card.innerHTML = `
            <div style="display: flex; gap: 8px; align-items: center;">
              <input type="text" name="module_titles[]" placeholder="Titre du module" style="flex: 1; height: 36px; padding: 0 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem; font-weight: 600; box-sizing: border-box;" />
              <button type="button" class="btn-remove-row" style="width: 30px; height: 30px; border-radius: 6px; border: 1px solid #e2e8f0; background: #fff; color: #94a3b8; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">&times;</button>
            </div>
            <textarea name="module_details[]" rows="2" placeholder="Détails du module..." style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.825rem; font-family: inherit; box-sizing: border-box;"></textarea>
          `;
          editModContainer.appendChild(card);
          card.querySelector("input").focus();
        });
      }

      // Soumission formulaire de modification (avec protection anti-double soumission)
      if (formEdit && !formEdit.dataset.hasSubmitListener) {
        formEdit.dataset.hasSubmitListener = "true";
        let isSubmittingEdit = false;

        formEdit.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (isSubmittingEdit) return;
          isSubmittingEdit = true;

          const id = document.getElementById("edit-formation-id").value;
          const submitBtn = document.getElementById("admin-btn-submit-edit-formation");
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = "Mise à jour...";
          }

          try {
            const formData = new FormData(formEdit);
            const res = await fetch(`/admin/formations/edit/${id}`, {
              method: "POST",
              body: formData,
              headers: { "Accept": "application/json" }
            });
            const data = await res.json();
            if (!res.ok || !data.success) throw new Error(data.error || "Erreur");

            closeModal(modalEdit, formEdit);
            if (typeof window.navigateTo === "function") {
              await window.navigateTo("/admin/formations", false);
            } else {
              window.location.reload();
            }
          } catch (err) {
            alert(err.message || "Erreur lors de la mise à jour.");
          } finally {
            isSubmittingEdit = false;
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Mettre à jour la formation";
            }
          }
        });
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", window.initAdminFormations);
    } else {
      window.initAdminFormations();
    }

