            .form-group
              label(style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 6px;") Débouchés & Métiers (séparés par des virgules)
              input(type="text" name="debouches" placeholder="Ex: Technicien de maintenance, Automaticien..." style="width: 100%; height: 40px; padding: 0 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.875rem; box-sizing: border-box;")

        .modal-form-actions(style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; position: sticky; bottom: 0; background: #fff; padding-top: 14px; border-top: 1px solid #e2e8f0;")
          button#admin-btn-cancel-add-formation(type="button" style="background: #fff; color: #475569; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px 18px; font-size: 0.875rem; font-weight: 600; cursor: pointer;") Annuler
          button#admin-btn-submit-add-formation(type="submit" style="background: #2563eb; color: #fff; border: none; border-radius: 8px; padding: 10px 22px; font-size: 0.875rem; font-weight: 600; cursor: pointer;") Enregistrer & Publier

  //- MODAL MODIFICATION DE FORMATION
  #admin-modal-edit-formation.edt-modal(role="dialog" aria-hidden="true" style="position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 999999; display: none; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;")
    .modal-overlay(style="position: absolute; inset: 0; width: 100%; height: 100%; background: rgba(15,23,42,0.65); backdrop-filter: blur(4px);")
    .modal-container(style="position: relative; width: 94vw; max-width: 900px; max-height: 90vh; background: #fff; border-radius: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.2); display: flex; flex-direction: column; overflow: hidden; z-index: 10;")
      .modal-header(style="display: flex; align-items: center; justify-content: space-between; padding: 16px 22px; border-bottom: 1px solid #e2e8f0; background: #f8fafc;")
        div
          h3(style="font-size: 1.15rem; font-weight: 700; color: #0f172a; margin: 0;") Modifier la formation
