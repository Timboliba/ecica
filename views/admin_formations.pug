        button#admin-modal-edit-formation-close(type="button" title="Fermer" style="width: 34px; height: 34px; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; color: #64748b; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;")
