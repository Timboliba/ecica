            input#edit-formation-title(type="text" name="title" required style="width: 100%; height: 42px; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box; outline: none;")

          .form-grid-2(style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;")
