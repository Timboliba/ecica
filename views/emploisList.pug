extends ./layout.pug

block content
    .edt-container
        //- TOP HEADER
        .edt-header
            .edt-header-left
                .edt-icon-wrapper
                    svg(width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        rect(x="3" y="4" width="18" height="18" rx="2" ry="2")
                        line(x1="16" y1="2" x2="16" y2="6")
                        line(x1="8" y1="2" x2="8" y2="6")
                        line(x1="3" y1="10" x2="21" y2="10")
                        path(d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01")
                .edt-header-info
                    h1.edt-title Emplois du temps
                    p.edt-subtitle Consultez et téléchargez l'emploi du temps de chaque classe (Word, PDF, Excel, Image).

        //- SEARCH BAR
        .edt-search-box
            svg.search-icon(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                circle(cx="11" cy="11" r="8")
                line(x1="21" y1="21" x2="16.65" y2="16.65")
            input#edt-search-input.search-input(type="text" placeholder="Rechercher une classe, un format (Word, PDF...), une description..." autocomplete="off")
            button#btn-clear-search.btn-clear-search(type="button" style="display: none;" title="Effacer la recherche") &times;

        //- TABLE CARD
        .edt-card
            .table-responsive
                table.edt-table
                    thead
                        tr
                            th.th-class Classe
                            th.th-type Format
                            th.th-desc Description
                            th.th-actions Actions
                    tbody#edt-tbody
                        if classes && classes.length
                            each item, index in classes
                                - const isBottomRow = index >= (classes.length - 3);
                                tr.edt-row(data-name=item.name.toLowerCase() data-badge=item.badge.toLowerCase() data-desc=(item.description || "").toLowerCase() data-type=(item.fileTypeLabel || "").toLowerCase() data-id=item.id)
                                    td.td-class
                                        .class-identity
                                            span.class-name= item.name
                                    td.td-type
                                        if item.isWord
                                            span.format-pill.format-word
                                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                                    path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                                                    polyline(points="14 2 14 8 20 8")
                                                    line(x1="9" y1="13" x2="15" y2="13")
                                                    line(x1="9" y1="17" x2="15" y2="17")
                                                span= item.isDocx ? "Word (.docx)" : "Word (.doc)"
                                        else if item.isPdf
                                            span.format-pill.format-pdf
                                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                                    path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                                                    polyline(points="14 2 14 8 20 8")
                                                span PDF
                                        else if item.isExcel
                                            span.format-pill.format-excel
                                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                                    rect(x="3" y="3" width="18" height="18" rx="2" ry="2")
                                                    line(x1="3" y1="9" x2="21" y2="9")
                                                    line(x1="9" y1="21" x2="9" y2="9")
                                                span Excel
                                        else if item.isImage
                                            span.format-pill.format-img
                                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                                    rect(x="3" y="3" width="18" height="18" rx="2" ry="2")
                                                    circle(cx="8.5" cy="8.5" r="1.5")
                                                    polyline(points="21 15 16 10 5 21")
                                                span Image
                                        else
                                            span.format-pill.format-doc
                                                svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                                    path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
                                                span= item.ext ? item.ext.toUpperCase().replace(".", "") : "Fichier"
                                    td.td-desc
                                        span.desc-text= item.description || "—"
                                    td.td-actions
                                        .actions-wrap
                                            button.btn-action.btn-preview(type="button" data-url=item.url data-name=item.name data-badge=item.badge data-color=(item.badgeColor || '#2563eb') data-is-word=(item.isWord ? "true" : "false") data-is-docx=(item.isDocx ? "true" : "false") data-is-pdf=(item.isPdf ? "true" : "false") data-is-excel=(item.isExcel ? "true" : "false") data-is-image=(item.isImage ? "true" : "false"))
                                                svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                                    path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
                                                    circle(cx="12" cy="12" r="3")
                                                span Voir
                                            a.btn-action.btn-download(href=item.url download=item.name)
                                                svg(width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                                    path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4")
                                                    polyline(points="7 10 12 15 17 10")
                                                    line(x1="12" y1="15" x2="12" y2="3")
                                                span Télécharger
                                            .more-menu-wrap(class=(isBottomRow ? "dropup" : ""))
                                                button.btn-more(type="button" title="Plus d'actions" aria-expanded="false")
                                                    svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                                        circle(cx="12" cy="12" r="1")
                                                        circle(cx="12" cy="5" r="1")
                                                        circle(cx="12" cy="19" r="1")
                                                .more-dropdown
                                                    a.dropdown-item(href=item.url target="_blank" rel="noopener")
                                                        svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                                            path(d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6")
                                                            polyline(points="15 3 21 3 21 9")
                                                            line(x1="10" y1="14" x2="21" y2="3")
                                                        span Ouvrir dans un nouvel onglet
                                                    button.dropdown-item.btn-copy-link(type="button" data-url=item.url)
                                                        svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                                                            rect(x="9" y="9" width="13" height="13" rx="2" ry="2")
                                                            path(d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1")
                                                        span Copier le lien direct
                        else
                            tr
                                td.empty-state-cell(colspan="4")
                                    p Aucun emploi du temps disponible pour le moment.

            //- NO SEARCH RESULTS ROW
            #no-results-message.empty-state(style="display: none;")
                svg(width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5")
                    circle(cx="11" cy="11" r="8")
                    line(x1="21" y1="21" x2="16.65" y2="16.65")
                    line(x1="8" y1="11" x2="14" y2="11")
                p Aucune classe trouvée pour votre recherche.

        //- BOTTOM PAGINATION & COUNTER
        .edt-footer
            .edt-count
                span#classes-count= `${classes ? classes.length : 0} classes configurées`
            .edt-pagination
                button#btn-prev-page.page-btn.page-arrow(type="button" disabled title="Page précédente")
                    svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="15 18 9 12 15 6")
                button.page-btn.page-num.active(type="button") 1
                button#btn-next-page.page-btn.page-arrow(type="button" disabled title="Page suivante")
                    svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline(points="9 18 15 12 9 6")

    //- PREVIEW MODAL
    #modal-preview.edt-modal(role="dialog" aria-hidden="true")
        .modal-overlay
        .modal-container
            .modal-header
                .modal-title-wrap
                    h3#modal-title Emploi du temps
                .modal-header-actions
                    a#modal-open-newtab.btn-icon(href="#" target="_blank" title="Ouvrir dans un nouvel onglet")
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6")
                            polyline(points="15 3 21 3 21 9")
                            line(x1="10" y1="14" x2="21" y2="3")
                    a#modal-download-btn.btn-icon(href="#" download title="Télécharger")
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4")
                            polyline(points="7 10 12 15 17 10")
                            line(x1="12" y1="15" x2="12" y2="3")
                    button#modal-close-btn.btn-icon.btn-close(type="button" title="Fermer")
                        svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            line(x1="18" y1="6" x2="6" y2="18")
                            line(x1="6" y1="6" x2="18" y2="18")
            .modal-body
                #modal-loader.modal-loader
                    .spinner
                    p Chargement du document...
                #modal-content-area.modal-content-area

    //- TOAST NOTIFICATION
    #toast-notification.edt-toast(style="display:none;")

    //- SCRIPTS & LIBRARIES (Mammoth.js for Word preview, SheetJS for Excel preview)
    script(src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.8.0/mammoth.browser.min.js")
    script(src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js")
    script.
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("edt-search-input");
            const btnClearSearch = document.getElementById("btn-clear-search");
            const countLabel = document.getElementById("classes-count");
            const noResults = document.getElementById("no-results-message");

            // Modal Preview Elements
            const modalPreview = document.getElementById("modal-preview");
            const modalTitle = document.getElementById("modal-title");
            const modalContentArea = document.getElementById("modal-content-area");
            const modalLoader = document.getElementById("modal-loader");
            const modalOpenNewtab = document.getElementById("modal-open-newtab");
            const modalDownloadBtn = document.getElementById("modal-download-btn");
            const modalCloseBtn = document.getElementById("modal-close-btn");

            // Toast
            const toast = document.getElementById("toast-notification");
            function showToast(message, isError = false) {
                if (!toast) return;
                toast.textContent = message;
                toast.style.background = isError ? "#ef4444" : "#0f172a";
                toast.style.display = "block";
                toast.classList.add("toast-show");
                setTimeout(() => {
                    toast.classList.remove("toast-show");
                    setTimeout(() => { toast.style.display = "none"; }, 300);
                }, 3500);
            }

            // Check URL parameters for flash messages
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get("success")) {
                showToast("Emploi du temps enregistré avec succès !");
                window.history.replaceState({}, document.title, window.location.pathname);
            }
            if (urlParams.get("error")) {
                showToast(urlParams.get("error"), true);
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            // --- 1. Real-time Search Filter ---
            function performSearch() {
                const query = (searchInput.value || "").trim().toLowerCase();
                let visibleCount = 0;

                if (query.length > 0) {
                    btnClearSearch.style.display = "block";
                } else {
                    btnClearSearch.style.display = "none";
                }

                const currentRows = document.querySelectorAll(".edt-row");
                currentRows.forEach(row => {
                    const name = row.getAttribute("data-name") || "";
                    const badge = row.getAttribute("data-badge") || "";
                    const desc = row.getAttribute("data-desc") || "";
                    const type = row.getAttribute("data-type") || "";

                    if (name.includes(query) || badge.includes(query) || desc.includes(query) || type.includes(query)) {
                        row.style.display = "";
                        visibleCount++;
                    } else {
                        row.style.display = "none";
                    }
                });

                countLabel.textContent = `${visibleCount} classe${visibleCount > 1 ? "s" : ""} configurée${visibleCount > 1 ? "s" : ""}`;
                if (visibleCount === 0 && currentRows.length > 0) {
                    noResults.style.display = "flex";
                } else {
                    noResults.style.display = "none";
                }
            }

            if (searchInput) searchInput.addEventListener("input", performSearch);
            if (btnClearSearch) {
                btnClearSearch.addEventListener("click", () => {
                    searchInput.value = "";
                    performSearch();
                    searchInput.focus();
                });
            }

            // --- 2. Action Menu Dropdown Toggle ---
            document.addEventListener("click", function (e) {
                const btnMore = e.target.closest(".btn-more");
                if (btnMore) {
                    e.stopPropagation();
                    const menuWrap = btnMore.closest(".more-menu-wrap");
                    const isOpen = menuWrap.classList.contains("is-open");

                    document.querySelectorAll(".more-menu-wrap.is-open").forEach(w => w.classList.remove("is-open"));

                    if (!isOpen) {
                        menuWrap.classList.add("is-open");
                        btnMore.setAttribute("aria-expanded", "true");
                    }
                } else if (!e.target.closest(".more-dropdown")) {
                    document.querySelectorAll(".more-menu-wrap.is-open").forEach(w => {
                        w.classList.remove("is-open");
                        const b = w.querySelector(".btn-more");
                        if (b) b.setAttribute("aria-expanded", "false");
                    });
                }
            });

            // --- 3. Preview Modal Logic for Word (docx/doc), PDF, Excel, Images ---
            function openPreview(item) {
                modalTitle.textContent = `Emploi du temps - ${item.name}`;
                modalOpenNewtab.href = item.url;
                modalDownloadBtn.href = item.url;
                modalDownloadBtn.setAttribute("download", item.name);

                modalContentArea.innerHTML = "";
                modalLoader.style.display = "flex";
                modalPreview.classList.add("is-active");
                modalPreview.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";

                const url = item.url;
                const isWord = item.isWord === "true" || /\.(docx|doc|dotx|dot)$/i.test(url);
                const isDocx = item.isDocx === "true" || /\.docx$/i.test(url);
                const isPdf = item.isPdf === "true" || /\.pdf$/i.test(url);
                const isExcel = item.isExcel === "true" || /\.(xlsx|xls|csv|ods)$/i.test(url);
                const isImg = item.isImage === "true" || /\.(png|jpg|jpeg|webp|gif|svg)$/i.test(url);

                if (isDocx && typeof mammoth !== "undefined") {
                    // Preview Word .docx using Mammoth.js
                    fetch(url)
                        .then(res => {
                            if (!res.ok) throw new Error("HTTP error " + res.status);
                            return res.arrayBuffer();
                        })
                        .then(buf => mammoth.convertToHtml({ arrayBuffer: buf }))
                        .then(result => {
                            modalLoader.style.display = "none";
                            const wordContainer = document.createElement("div");
                            wordContainer.className = "word-viewer-container";
                            wordContainer.innerHTML = `
                                <div class="word-doc-paper">
                                    <div class="word-doc-header-bar">
                                        <div class="word-badge-tag">Document Microsoft Word (.docx)</div>
                                        <div class="word-doc-actions">
                                            <a href="${url}" download class="word-download-btn">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                                Télécharger l'original
                                            </a>
                                        </div>
                                    </div>
                                    <div class="word-content-render">${result.value || "<p>Document vide ou sans texte extractible.</p>"}</div>
                                </div>
                            `;
                            modalContentArea.appendChild(wordContainer);
                        })
                        .catch(err => {
                            console.error(err);
                            renderFallbackView(url, item.name, "Word (.docx)", "#1e40af");
                        });
                } else if (isWord) {
                    // Word .doc (binary format): rich fallback card
                    renderFallbackView(url, item.name, "Document Microsoft Word (.doc)", "#1e40af");
                } else if (isPdf) {
                    const iframe = document.createElement("iframe");
                    iframe.className = "modal-iframe";
                    iframe.src = url;
                    iframe.onload = () => { modalLoader.style.display = "none"; };
                    modalContentArea.appendChild(iframe);
                } else if (isExcel && typeof XLSX !== "undefined") {
                    fetch(url)
                        .then(res => {
                            if (!res.ok) throw new Error("HTTP error " + res.status);
                            return res.arrayBuffer();
                        })
                        .then(buffer => {
                            const workbook = XLSX.read(buffer, { type: "array" });
                            modalLoader.style.display = "none";

                            const excelWrap = document.createElement("div");
                            excelWrap.className = "excel-container";

                            if (workbook.SheetNames.length > 1) {
                                const tabsBar = document.createElement("div");
                                tabsBar.className = "excel-tabs-bar";
                                workbook.SheetNames.forEach((sheetName, index) => {
                                    const tabBtn = document.createElement("button");
                                    tabBtn.className = `excel-tab-btn ${index === 0 ? "active" : ""}`;
                                    tabBtn.textContent = sheetName;
                                    tabBtn.addEventListener("click", () => {
                                        tabsBar.querySelectorAll(".excel-tab-btn").forEach(b => b.classList.remove("active"));
                                        tabBtn.classList.add("active");
                                        renderSheetTable(workbook.Sheets[sheetName], excelWrap);
                                    });
                                    tabsBar.appendChild(tabBtn);
                                });
                                excelWrap.appendChild(tabsBar);
                            }

                            const tableContainer = document.createElement("div");
                            tableContainer.id = "excel-sheet-render";
                            excelWrap.appendChild(tableContainer);
                            modalContentArea.appendChild(excelWrap);

                            renderSheetTable(workbook.Sheets[workbook.SheetNames[0]], excelWrap);
                        })
                        .catch(() => {
                            renderFallbackView(url, item.name, "Classeur Excel", "#15803d");
                        });
                } else if (isImg) {
                    const img = document.createElement("img");
                    img.className = "modal-preview-img";
                    img.src = url;
                    img.alt = item.name;
                    img.onload = () => { modalLoader.style.display = "none"; };
                    modalContentArea.appendChild(img);
                } else {
                    renderFallbackView(url, item.name, "Document", "#475569");
                }
            }

            function renderFallbackView(url, name, typeLabel, brandColor) {
                modalLoader.style.display = "none";
                modalContentArea.innerHTML = `
                    <div class="modal-fallback-card">
                        <div class="fallback-icon-circle" style="background: ${brandColor}15; color: ${brandColor};">
                            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </div>
                        <h4 class="fallback-title">${name}</h4>
                        <p class="fallback-desc">${typeLabel} prêt à être consulté ou téléchargé.</p>
                        <div class="fallback-btn-group">
                            <a href="${url}" download class="btn-primary" style="background: ${brandColor};">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                <span>Télécharger le fichier</span>
                            </a>
                            <a href="${url}" target="_blank" class="btn-secondary">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                <span>Ouvrir directement</span>
                            </a>
                        </div>
                    </div>
                `;
            }

            function renderSheetTable(sheet, container) {
                const target = container.querySelector("#excel-sheet-render");
                if (!target) return;
                target.innerHTML = "";

                const rows = XLSX.utils.sheet_to_json(sheet, { header: 1, raw: false, defval: "" });
                if (!rows.length) {
                    target.innerHTML = `<p class="sheet-empty">Feuille vide.</p>`;
                    return;
                }

                const tableWrap = document.createElement("div");
                tableWrap.className = "modal-table-wrap";
                const table = document.createElement("table");
                table.className = "excel-rendered-table";

                const maxCols = rows.reduce((max, r) => Math.max(max, r.length), 0);
                const thead = document.createElement("thead");
                const tbody = document.createElement("tbody");

                rows.forEach((row, rIdx) => {
                    const tr = document.createElement("tr");
                    for (let cIdx = 0; cIdx < maxCols; cIdx++) {
                        const cell = document.createElement(rIdx === 0 ? "th" : "td");
                        cell.textContent = row[cIdx] != null ? String(row[cIdx]) : "";
                        tr.appendChild(cell);
                    }
                    if (rIdx === 0) thead.appendChild(tr);
                    else tbody.appendChild(tr);
                });

                table.appendChild(thead);
                table.appendChild(tbody);
                tableWrap.appendChild(table);
                target.appendChild(tableWrap);
            }

            function closePreview() {
                modalPreview.classList.remove("is-active");
                modalPreview.setAttribute("aria-hidden", "true");
                modalContentArea.innerHTML = "";
                document.body.style.overflow = "";
            }

            if (modalCloseBtn) modalCloseBtn.addEventListener("click", closePreview);
            modalPreview.querySelector(".modal-overlay").addEventListener("click", closePreview);

            // Global Click for preview, copy link & delete
            document.addEventListener("click", function (e) {
                const btn = e.target.closest(".btn-preview");
                if (btn) {
                    const data = {
                        url: btn.getAttribute("data-url"),
                        name: btn.getAttribute("data-name"),
                        badge: btn.getAttribute("data-badge"),
                        color: btn.getAttribute("data-color"),
                        isWord: btn.getAttribute("data-is-word"),
                        isDocx: btn.getAttribute("data-is-docx"),
                        isPdf: btn.getAttribute("data-is-pdf"),
                        isExcel: btn.getAttribute("data-is-excel"),
                        isImage: btn.getAttribute("data-is-image")
                    };
                    openPreview(data);
                }

                const copyBtn = e.target.closest(".btn-copy-link");
                if (copyBtn) {
                    const fileUrl = window.location.origin + copyBtn.getAttribute("data-url");
                    navigator.clipboard.writeText(fileUrl).then(() => {
                        showToast("Lien direct copié !");
                    }).catch(() => {
                        showToast("Lien: " + fileUrl);
                    });
                    document.querySelectorAll(".more-menu-wrap.is-open").forEach(w => w.classList.remove("is-open"));
                }

                const delBtn = e.target.closest(".btn-delete-row");
                if (delBtn) {
                    const id = delBtn.getAttribute("data-id");
                    const name = delBtn.getAttribute("data-name");
                    if (confirm(`Voulez-vous vraiment supprimer l'emploi du temps de "${name}" ?`)) {
                        fetch(`/Emplois/delete/${id}`, { method: "POST", headers: { "Accept": "application/json" } })
                            .then(res => res.json())
                            .then(data => {
                                const row = delBtn.closest(".edt-row");
                                if (row) row.remove();
                                performSearch();
                                showToast("Emploi du temps supprimé avec succès.");
                            })
                            .catch(err => {
                                console.error(err);
                                showToast("Erreur lors de la suppression.", true);
                            });
                    }
                    document.querySelectorAll(".more-menu-wrap.is-open").forEach(w => w.classList.remove("is-open"));
                }
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") {
                    closePreview();
                    document.querySelectorAll(".more-menu-wrap.is-open").forEach(w => w.classList.remove("is-open"));
                }
            });
        });

    style.
        /* =========================================================
