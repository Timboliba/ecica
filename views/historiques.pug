extends ./layout.pug
block content 
    .historiques-containers 
        h2(class="bigTittle") Historiques Space
        .historique-container 
            .directeur-actuel
                .photo
                    img(src="/img/avatar.webp", alt="directeur actuel", width="100", height="100", loading="lazy", decoding="async")
                .info
                    h3 Directeur Général 
                    p(class="text") Mr BRAHIMA H TIMBOLIBA
            .teams-container
                .directeur-des-etudes
                    .photo
                        img(src="/img/avatar.webp", alt="directeur des études", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h3 Directeur des Etudes 
                        p(class="text") Mr Nouhoum Dembélé
                .surveillant
                    .photo
                        img(src="/img/avatar.webp", alt="surveillant général", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h3 Surveillant Général 
                        p(class="text") Mr Youssouf Maïga
                .chef-des-travaux
                    .photo
                        img(src="/img/avatar.webp", alt="chef des travaux", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h3 Chef des travaux 
                        p(class="text") Mr Issiaka Dolo
                .econome
                    .photo
                        img(src="/img/avatar.webp", alt="econome", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h3 Econome 
                        p(class="text") Mme Doussou Cissé
            .les-enciens-directeur
                .old-director
                    .photo
                        img(src="/img/avatar.webp", alt="sow", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h4 Directeur: 2006 - 2013 
                        p(class="text") Mr FAMOLO TRAORE
                
                .old-director
                    .photo
                        img(src="/img/avatar.webp", alt="famolo", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h4 Directeur: 2000 - 2006
                        p(class="text") Mr MAMADOU SIDIBE
                .old-director
                    .photo
                        img(src="/img/avatar.webp", alt="mamadou", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h4 Directeur: 1996 - 2000 
                        p(class="text") Mr EL HASSAN DIARRA
                .old-director
                    .photo
                        img(src="/img/avatar.webp", alt="hassan", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h4 Directeur: 1994 - 1996 
                        p(class="text") Mr CHEICK OUMAR DIALLO
                .old-director
                    .photo
                        img(src="/img/avatar.webp", alt="hama", width="100", height="100", loading="lazy", decoding="async")
                    .info
                        h4 Directeur: 1993 - 1994 
                        p(class="text") Mr HAMA EL HADJ MAIGA SIMBARA