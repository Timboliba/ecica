doctype html
html(lang="fr")
  head
    title= pageTitle || "ECICA"
    meta(name="description", content="ECICA - École Centrale pour l'Industrie, le Commerce et l'Administration")
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="shortcut icon", href="/img/logo_ecica.webp", type="image/x-icon")
    link(rel="preload", as="image", href="/img/picture4.webp", fetchpriority="high")
    link(rel="stylesheet" href="/css/layout.css?v=2.2")

  body
    .main-container
      .container

        include ./includes/header.pug

        main.main-content
          include ./includes/navbar.pug

          .block-content
            block content

        include ./includes/footer.pug

    script(src="/javascript/script.js?v=2.2", type="module")